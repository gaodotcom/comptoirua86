<iframe id="newsletter-preview" title="Aperçu de la newsletter" srcdoc="{{ html }}" style="width:100%;height:1400px;border:1px solid #ccc;border-radius:6px;background:#fff;"></iframe>
<script src="{{ asset_url('public/js/newsletter.js') }}"></script>
{% endblock %}
