{% extends 'layout.twig' %}
{% block content %}
<div class="d-flex align-items-baseline align-items-md-center gap-2 mb-3">
    <i class="bi bi-archive fs-2 text-primary lh-1 ms-1 me-2 flex-shrink-0"></i>
    <h1 class="h2 mb-0 flex-grow-1 min-w-0">Archives des courses</h1>
    <div class="flex-shrink-0">
        <a class="btn btn-outline-primary btn-sm" href="{{ page_url('races') }}" title="Retour aux courses"><i class="bi bi-arrow-left"></i><span class="d-none d-md-inline ms-1">Courses</span></a>
    </div>
</div>
<div class="d-flex flex-wrap gap-2 mb-4" role="group" aria-label="Saison">
    {% for s in seasons %}
        <a class="btn btn-sm {{ s == season ? 'btn-primary' : 'btn-outline-primary' }}" href="{{ page_url('races-archives', {'saison': s}) }}"{% if s == season %} aria-current="page"{% endif %}>{{ s }}</a>
    {% endfor %}
</div>
{% if raceCards is empty %}
    <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Aucune course passée sur la saison {{ season }}.</div>
{% else %}
    <p class="text-secondary small mb-3">Saison {{ season }} : {{ raceCards|length }} course{{ raceCards|length > 1 ? 's' : '' }}.</p>
    <div class="row g-3">
        {% for card in raceCards %}
            {% set race = card.race %}{% set registered = card.responses.registered %}
            <div class="col-12 col-md-6 col-lg-4 anchor-target" id="course-{{ race.id }}">
                <div class="card shadow-sm h-100">
                    <div class="card-body p-2 p-md-3">
                        <div class="d-flex align-items-start gap-2 mb-1">
                            {% set favicon = race_favicon_url(race) %}
                            {% if favicon %}<img src="{{ favicon }}" class="rounded flex-shrink-0 mt-1" width="20" height="20" alt="">{% else %}<i class="bi bi-signpost-2 flex-shrink-0"></i>{% endif %}
                            <strong class="flex-grow-1 min-w-0 text-break">{{ race.title }}</strong>
                            {% if card.canEdit %}<a href="{{ page_url('race-form', {'id': race.id}) }}" class="btn btn-outline-primary btn-sm py-0 px-1 d-inline-flex align-items-center flex-shrink-0" title="Modifier"><i class="bi bi-pencil"></i></a>{% endif %}
                        </div>
                        <div class="small text-secondary">
                            <div><i class="bi bi-calendar-event me-1"></i>{{ format_date(race.start_date) }}{% if race.end_date is not empty %} → {{ format_date(race.end_date) }}{% endif %}</div>
                            {% if race.location is not empty %}<div><i class="bi bi-geo-alt me-1"></i>{{ race.location }}</div>{% endif %}
                            <div class="text-break"><i class="bi bi-signpost-2 me-1"></i>{{ race.distances }}</div>
                            {% if race.website_url is not empty %}<div><a href="{{ race.website_url }}" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right me-1"></i>Site web</a></div>{% endif %}
                        </div>
                    </div>
                    {% if registered|length > 0 %}
                        <div class="card-footer bg-white small"><i class="bi bi-check2-circle me-1"></i><span class="fw-semibold">{{ registered|length }} inscrit{{ registered|length > 1 ? 's' : '' }} :</span> {% for m in registered %}{{ m.first_name ~ ' ' ~ m.last_name }}{% if not loop.last %}, {% endif %}{% endfor %}</div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
