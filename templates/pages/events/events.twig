{% extends 'layout.twig' %}
{% block content %}
<div class="d-flex align-items-baseline align-items-md-center gap-2 mb-4">
    <i class="bi bi-calendar3 fs-2 text-primary lh-1 ms-1 me-2 flex-shrink-0"></i>
    <h1 class="h2 mb-0 flex-grow-1 min-w-0">L'agenda UA86</h1>
    <div class="flex-shrink-0 d-flex gap-1">
        <a class="btn btn-outline-primary btn-sm" href="{{ page_url('calendar') }}" title="Voir le calendrier"><i class="bi bi-calendar3"></i><span class="d-none d-md-inline ms-1">Calendrier</span></a>
        {% if is_admin() %}<a class="btn btn-outline-success btn-sm" href="{{ page_url('event-form') }}"><i class="bi bi-plus-lg"></i><span class="d-none d-md-inline ms-1">Ajouter un événement</span></a>{% endif %}
    </div>
</div>
{% if upcomingEvents is empty and pastEvents is empty %}
    <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Aucun événement pour le moment.</div>
{% else %}
    {% if upcomingEvents is not empty %}
    <div class="row g-4 mb-4">
        {% for event in upcomingEvents %}
            {% if event.published or is_admin() %}
            <div class="col-12 col-md-6 col-lg-4 anchor-target" id="evenement-{{ event.id }}">
                <div class="card shadow-sm h-100 {{ not event.published ? 'bg-body-secondary' : '' }}">
                    <div class="card-header page-card-header d-flex align-items-baseline align-items-md-center gap-2">
                        <i class="bi bi-calendar-event fs-5 me-1 flex-shrink-0"></i>
                        <span class="fs-5 flex-grow-1">{{ event.title }}{% if not event.published %} <span class="badge text-bg-secondary fw-normal">Brouillon</span>{% endif %}</span>
                    </div>
                    <div class="card-body">
                        <div class="d-flex gap-1 flex-wrap text-secondary small mb-3">
                            <span class="me-3"><i class="bi bi-calendar-event me-1"></i>{{ format_date(event.start_date) }}{% if event.end_date is not empty %} → {{ format_date(event.end_date) }}{% endif %}</span>
                            {% if event.location is not empty %}<span class="me-3"><i class="bi bi-geo-alt me-1"></i>{{ event.location }}</span>{% endif %}
                        </div>
                        {% if event.description is not empty %}<p class="small text-body-secondary mb-0">{{ event.description|nl2br }}</p>{% endif %}
                    </div>
                    {% if is_admin() %}
                    <div class="card-footer bg-transparent d-flex gap-1 justify-content-end">
                        <form method="post" action="{{ page_url('events') }}" class="d-inline-flex m-0"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="action" value="toggle_published"><input type="hidden" name="event_id" value="{{ event.id }}"><button class="btn btn-outline-secondary btn-sm py-0 px-1 d-inline-flex align-items-center" type="submit" title="{{ event.published ? 'Dépublier' : 'Publier' }}"><i class="bi bi-{{ event.published ? 'eye-slash' : 'eye' }}"></i></button></form>
                        <a href="{{ page_url('event-form', {'id': event.id}) }}" class="btn btn-outline-primary btn-sm py-0 px-1 d-inline-flex align-items-center" title="Modifier"><i class="bi bi-pencil"></i></a>
                        <form method="post" action="{{ page_url('events') }}" onsubmit="return confirm('Supprimer cet événement ?');" class="d-inline-flex m-0">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="action" value="delete_event"><input type="hidden" name="event_id" value="{{ event.id }}">
                            <button class="btn btn-outline-danger btn-sm py-0 px-1 d-inline-flex align-items-center" type="submit" title="Supprimer"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                    {% endif %}
                </div>
            </div>
            {% endif %}
        {% endfor %}
    </div>
    {% endif %}
    {% if pastEvents is not empty %}
    <h2 class="h4 text-secondary mb-3 fw-semibold">Événements passés</h2>
    <div class="row g-3">
        {% for event in pastEvents %}
            {% if event.published or is_admin() %}
            <div class="col-12 anchor-target" id="evenement-{{ event.id }}">
                <div class="card shadow-sm {{ not event.published ? 'bg-body-secondary' : '' }}">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <div>
                                <strong>{{ event.title }}</strong>{% if not event.published %} <span class="badge text-bg-secondary fw-normal">Brouillon</span>{% endif %}
                                <span class="badge text-bg-light border fw-normal ms-2">{{ format_date(event.start_date) }}{% if event.end_date is not empty %} → {{ format_date(event.end_date) }}{% endif %}</span>
                                {% if event.location is not empty %}<span class="small ms-2"><i class="bi bi-geo-alt me-1"></i>{{ event.location }}</span>{% endif %}
                            </div>
                            {% if is_admin() %}
                                <div class="d-flex gap-2 align-items-center flex-shrink-0">
                                    <form method="post" action="{{ page_url('events') }}" class="d-inline-flex m-0"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="action" value="toggle_published"><input type="hidden" name="event_id" value="{{ event.id }}"><button class="btn btn-outline-secondary btn-sm py-0 px-1 d-inline-flex align-items-center" type="submit" title="{{ event.published ? 'Dépublier' : 'Publier' }}"><i class="bi bi-{{ event.published ? 'eye-slash' : 'eye' }}"></i></button></form>
                                    <a href="{{ page_url('event-form', {'id': event.id}) }}" class="btn btn-outline-primary btn-sm py-0 px-1 d-inline-flex align-items-center" title="Modifier"><i class="bi bi-pencil"></i></a>
                                    <form method="post" action="{{ page_url('events') }}" onsubmit="return confirm('Supprimer cet événement ?');" class="d-inline-flex m-0">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="action" value="delete_event"><input type="hidden" name="event_id" value="{{ event.id }}">
                                        <button class="btn btn-outline-danger btn-sm py-0 px-1 d-inline-flex align-items-center" type="submit" title="Supprimer"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}
        {% endfor %}
    </div>
    {% endif %}
{% endif %}
{% endblock %}
