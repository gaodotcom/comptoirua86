{% extends 'layout.twig' %}
{% block content %}
<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex align-items-baseline align-items-md-center gap-2 mb-3">
                    <i class="bi bi-newspaper fs-4 lh-1 flex-shrink-0"></i>
                    <h1 class="h4 mb-0 flex-grow-1 min-w-0">{{ isEditing ? 'Modifier l\'information' : 'Ajouter une information' }}</h1>
                </div>
                <form method="post" action="{{ isEditing ? page_url('news-form', {'id': newsId}) : page_url('news-form') }}">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                    <div class="mb-3"><label class="form-label" for="title">Titre</label><input class="form-control" type="text" id="title" name="title" value="{{ newsTitle }}" required></div>
                    <div class="mb-3"><label class="form-label" for="content">Contenu</label><textarea class="form-control" id="content" name="content" rows="8" required>{{ newsContent }}</textarea></div>
                    <div class="form-check mb-3"><input class="form-check-input" type="checkbox" value="1" id="published" name="published" {{ newsPublished ? 'checked' : '' }}><label class="form-check-label" for="published">Publier</label></div>
                    <button class="btn btn-success" type="submit">{{ isEditing ? 'Enregistrer' : 'Ajouter' }}</button>
                    <a href="{{ page_url('news') }}" class="btn btn-outline-secondary ms-2">Annuler</a>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
