{% extends 'layout.twig' %}
{% block content %}
<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex align-items-baseline align-items-md-center gap-2 mb-3">
                    <i class="bi bi-clipboard2-pulse fs-4 lh-1 flex-shrink-0"></i>
                    <h1 class="h4 mb-0 flex-grow-1 min-w-0">Publier une semaine d'entraînement</h1>
                </div>
                <form method="post" action="{{ page_url('training-form') }}" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label" for="week_start">Début de semaine</label><input class="form-control" type="date" id="week_start" name="week_start" value="{{ defaultWeek }}" required></div>
                        <div class="col-md-6"><label class="form-label" for="title">Titre</label><input class="form-control" type="text" id="title" name="title" placeholder="Ex: Semaine 12" required></div>
                        <div class="col-12"><label class="form-label" for="presentation_text">Texte de présentation</label><textarea class="form-control" id="presentation_text" name="presentation_text" rows="5" required></textarea></div>
                        <div class="col-12"><label class="form-label" for="image">Image de la semaine</label><input class="form-control" type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp,image/gif" required></div>
                        <div class="col-12"><label class="form-label" for="comment_text">Commentaire complémentaire (facultatif)</label><textarea class="form-control" id="comment_text" name="comment_text" rows="3"></textarea></div>
                    </div>
                    <button class="btn btn-success mt-4" type="submit">Publier</button>
                    <a href="{{ page_url('trainings') }}" class="btn btn-outline-secondary mt-4 ms-2">Annuler</a>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
