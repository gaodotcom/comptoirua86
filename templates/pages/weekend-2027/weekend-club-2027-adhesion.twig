{% extends 'layout.twig' %}
{% block content %}
<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3"><i class="bi bi-signpost-split me-2"></i>Week-end club au Lozère Trail 2027</h1>
                <div class="alert alert-warning">
                    <i class="bi bi-lock"></i><span>L'accès au week-end club est réservé aux adhérents de la saison <strong>{{ schoolYear }}</strong>. Nous n'avons pas trouvé ton adhésion pour cette saison.</span>
                </div>
                <p>Si tu n'as pas encore renouvelé ton adhésion, c'est le moment ! Tu pourras ensuite te préinscrire au week-end club.</p>
                {% if config.helloasso_url %}
                <a href="{{ config.helloasso_url }}" target="_blank" rel="noopener" class="btn btn-primary mt-3"><i class="bi bi-credit-card me-1"></i>Renouveler mon adhésion</a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
