{% extends 'layout.twig' %}
{% block content %}
<div class="row justify-content-center">
    <div class="col-12 col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 mb-3 pb-5 border-bottom">Bienvenue sur le Comptoir des adhérents Ultramical86</h1>
                <div class="text-secondary mb-5 border-bottom">
                    <p class="mb-0"><strong>Lors de la première connexion</strong>, utilise l'email fourni lors de ton adhésion comme identifiant et ta date de naissance comme mot de passe (format jjmmaaaa).</p>
                    <p>Tu pourras ensuite définir ton propre mot de passe, et également créer un identifiant.</p>
                </div>
                <form method="post" action="{{ page_url('login') }}">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                    {% if redirectTarget %}<input type="hidden" name="redirect" value="{{ redirectTarget }}">{% endif %}
                    <div class="mb-3">
                        <label for="identifier" class="form-label"><strong>Identifiant</strong> (identifiant ou email)</label>
                        <input type="text" class="form-control" id="identifier" name="identifier" required>
                    </div>
                    <div class="mb-4">
                        <label for="password" class="form-label">Mot de passe</label>
                        <input type="password" class="form-control" id="password" name="password" required>
                    </div>
                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" name="remember" id="remember" value="1" checked>
                        <label class="form-check-label" for="remember">
                            Rester connecté
                            <span class="text-muted small d-block">Pratique sur mobile, notamment si tu as ajouté le site en raccourci sur ton écran d'accueil. À décocher sur un appareil partagé.</span>
                        </label>
                    </div>
                    <button class="btn btn-success w-100" type="submit">Se connecter</button>
                </form>
                <div class="text-center mt-4">
                    <a href="{{ page_url('forgot-password') }}" class="text-muted small text-decoration-none">
                        <i class="bi bi-key me-1"></i>Mot de passe oublié?
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
