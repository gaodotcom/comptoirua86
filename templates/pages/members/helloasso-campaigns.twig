{% extends 'layout.twig' %}
{% block content %}
<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex align-items-baseline align-items-md-center gap-2 mb-3">
                    <i class="bi bi-gear fs-4 lh-1 flex-shrink-0"></i>
                    <h1 class="h4 mb-0 flex-grow-1 min-w-0">Campagnes HelloAsso</h1>
                    <a href="{{ page_url('helloasso-import') }}" class="btn btn-outline-secondary btn-sm flex-shrink-0"><i class="bi bi-download"></i><span class="d-none d-md-inline ms-1">Importer les nouvelles adhésions</span></a>
                </div>

                {% if editingCampaign is not null %}
                    <div class="card border-primary mb-4">
                        <div class="card-header bg-primary text-white py-2">
                            <i class="bi bi-pencil me-1"></i>Modifier la campagne {{ editingCampaign.school_year }}
                        </div>
                        <div class="card-body">
                            <form method="post" action="{{ page_url('helloasso-campaigns', {edit: editId}) }}">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                <input type="hidden" name="action" value="save">
                                <div class="mb-3">
                                    <label class="form-label" for="url">URL de la page d'adhésion HelloAsso</label>
                                    <input type="url" class="form-control" id="url" name="url"
                                           value="{{ editingCampaign.url ?? '' }}"
                                           placeholder="https://www.helloasso.com/associations/ultramical86/adhesions/adhesion-2026-2027">
                                    <div class="form-text">Si le slug est vide, il sera déduit automatiquement de l'URL.</div>
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-7">
                                        <label class="form-label" for="slug">Slug de la campagne</label>
                                        <input type="text" class="form-control" id="slug" name="slug"
                                               value="{{ editingCampaign.slug ?? '' }}" placeholder="adhesion-2026-2027">
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label" for="school_year">Année scolaire</label>
                                        <input type="text" class="form-control" id="school_year" name="school_year"
                                               value="{{ editingCampaign.school_year ?? '' }}" placeholder="2026-2027" pattern="\d{4}-\d{4}">
                                    </div>
                                </div>
                                <div class="d-flex gap-2 mt-3">
                                    <button class="btn btn-success" type="submit">Mettre à jour</button>
                                    <a href="{{ page_url('helloasso-campaigns') }}" class="btn btn-outline-secondary">Annuler</a>
                                </div>
                            </form>
                        </div>
                    </div>
                {% else %}
                    <div class="card border-success mb-4">
                        <div class="card-header bg-success text-white py-2">
                            <i class="bi bi-plus-circle me-1"></i>Ajouter une campagne
                        </div>
                        <div class="card-body">
                            <form method="post" action="{{ page_url('helloasso-campaigns') }}">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                <input type="hidden" name="action" value="save">
                                <div class="mb-3">
                                    <label class="form-label" for="url">URL de la page d'adhésion HelloAsso</label>
                                    <input type="url" class="form-control" id="url" name="url"
                                           placeholder="https://www.helloasso.com/associations/ultramical86/adhesions/adhesion-2026-2027">
                                    <div class="form-text">Si le slug est vide, il sera déduit automatiquement de l'URL.</div>
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-7">
                                        <label class="form-label" for="slug">Slug de la campagne</label>
                                        <input type="text" class="form-control" id="slug" name="slug" placeholder="adhesion-2026-2027">
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label" for="school_year">Année scolaire</label>
                                        <input type="text" class="form-control" id="school_year" name="school_year" placeholder="2026-2027" pattern="\d{4}-\d{4}">
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-success" type="submit">Ajouter</button>
                                </div>
                            </form>
                        </div>
                    </div>
                {% endif %}

                {% if campaigns is not empty %}
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Année scolaire</th>
                                    <th>Slug</th>
                                    <th>URL</th>
                                    <th>Dernier import</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for c in campaigns %}
                                <tr>
                                    <td class="fw-semibold">{{ c.school_year }}</td>
                                    <td><code>{{ c.slug }}</code></td>
                                    <td class="small">
                                        {% if c.url %}<a href="{{ c.url }}" target="_blank" rel="noopener">{{ c.url[:50] }}{{ c.url|length > 50 ? '...' : '' }}</a>{% else %}<span class="text-muted">&mdash;</span>{% endif %}
                                    </td>
                                    <td class="small">
                                        {% if c.last_imported_at %}{{ format_date(c.last_imported_at|slice(0, 10)) }}{% else %}<span class="text-muted">jamais</span>{% endif %}
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ page_url('helloasso-campaigns', {edit: c.id}) }}" class="btn btn-outline-primary btn-sm" title="Modifier"><i class="bi bi-pencil"></i></a>
                                        <form method="post" action="{{ page_url('helloasso-campaigns') }}" class="d-inline" onsubmit="return confirm('Supprimer cette campagne ? Les adhésions importées restent en base.');">
                                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                            <input type="hidden" name="action" value="delete">
                                            <input type="hidden" name="campaign_id" value="{{ c.id }}">
                                            <button class="btn btn-outline-danger btn-sm" title="Supprimer"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-muted">Aucune campagne enregistrée. Ajoutez-en une ci-dessus.</p>
                {% endif %}

            </div>
        </div>
    </div>
</div>
{% endblock %}
