{% extends 'layout.twig' %}
{% block content %}
<div class="d-flex align-items-baseline align-items-md-center gap-2 mb-3 flex-wrap">
    <i class="bi bi-stopwatch fs-4 lh-1 flex-shrink-0"></i>
    <h1 class="h4 mb-0 flex-grow-1 min-w-0">Test VMA du 16 octobre 2026 — Participants</h1>
    <div class="d-flex gap-2 flex-shrink-0">
        <a href="{{ page_url('test-vma-2026') }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i><span class="d-none d-md-inline ms-1">Retour au formulaire</span></a>
        {% if is_admin() %}
            <a href="{{ page_url('test-vma-2026-inscrits', {'export': 'csv'}) }}" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-spreadsheet"></i><span class="d-none d-md-inline ms-1">Exporter en CSV</span></a>
        {% endif %}
    </div>
</div>

<div class="alert {{ closed ? 'alert-warning' : 'alert-success' }} d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
    <span>
        {% if closed %}<i class="bi bi-lock me-1"></i>Le formulaire est clos.{% else %}<i class="bi bi-unlock me-1"></i>Le formulaire est ouvert.{% endif %}
        <strong>{{ participants|length }}</strong> participant{{ participants|length > 1 ? 's' }}.
    </span>
    {% if is_admin() %}
    <form method="post" action="{{ page_url('test-vma-2026-inscrits') }}" class="m-0">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="action" value="toggle_closed">
        <button class="btn btn-sm {{ closed ? 'btn-success' : 'btn-outline-danger' }}" type="submit">
            {{ closed ? 'Rouvrir le formulaire' : 'Clôturer le formulaire' }}
        </button>
    </form>
    {% endif %}
</div>

{% if participants is empty %}
    <div class="alert alert-secondary">Aucun participant pour le moment.</div>
{% else %}
    <div class="row g-2">
        {% for p in participants %}
        <div class="col-6 col-md-3 col-lg-2">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center p-2">
                    {{ render_avatar({'first_name': p.first_name, 'last_name': p.last_name, 'photo_path': p.photo_path}, 72)|raw }}
                    <h2 class="h6 mt-2 mb-0">{{ p.first_name }} {{ p.last_name }}</h2>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
