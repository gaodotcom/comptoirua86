{% set newsCount = get_published_news()|length %}
{% set eventsCount = get_upcoming_events_count() %}
{% set cp = current_page %}

{# Le contrôle d'espaces (-%}) est indispensable ici : sans lui, la macro renvoie
   "active" entouré d'espaces/retours à la ligne, ce qui casse toute comparaison
   stricte du type `macros.nav_active(...) == 'active'`. #}
{%- macro nav_active(pageId, currentPage) -%}
    {%- set groups = {
        'trainings': ['trainings', 'training-form', 'training-edit'],
        'races': ['races', 'race-form']
    } -%}
    {%- set found = false -%}
    {%- for navKey, pages in groups -%}
        {%- if currentPage in pages and pageId in pages -%}
            active
            {%- set found = true -%}
        {%- endif -%}
    {%- endfor -%}
    {%- if not found and pageId == currentPage -%}active{%- endif -%}
{%- endmacro -%}

{% import _self as macros %}

{# Macro : items du menu user pour le volet mobile #}
{% macro user_menu_items(user) %}
    <li class="list-group-item text-secondary"><i class="bi bi-person-circle me-2"></i><strong>{{ user.first_name }} {{ user.last_name[:1] }}.</strong> ({{ role_label(user.role) }})</li>
    <li class="list-group-item nav-sub-item"><a class="text-decoration-none" href="{{ page_url('profile') }}">Afficher mon profil</a></li>
    <li class="list-group-item nav-sub-item"><a class="text-decoration-none" href="{{ page_url('change-password') }}">Modifier mon mot de passe</a></li>
    {% if can_manage_trainings() %}
        <li class="list-group-item nav-sub-item border-top border-bottom-0"><a class="text-decoration-none" href="{{ page_url('training-form') }}">Publier un entraînement</a></li>
    {% endif %}
    {% if can_view_detailed_members() %}
        <li class="list-group-item nav-sub-item border-top border-bottom-0"><a class="text-decoration-none" href="{{ page_url('season-members') }}">Adhérents par saison</a></li>
        <li class="list-group-item nav-sub-item "><a class="text-decoration-none" href="{{ page_url('inactive-members') }}">Adhérents désactivés</a></li>
    {% endif %}
    {% if is_admin() %}
        <li class="list-group-item nav-sub-item border-top border-bottom-0"><a class="text-decoration-none" href="{{ page_url('helloasso-campaigns') }}">Campagnes HelloAsso</a></li>
        <li class="list-group-item nav-sub-item"><a class="text-decoration-none" href="{{ page_url('active-years') }}">Saisons actives</a></li>
        <li class="list-group-item nav-sub-item"><a class="text-decoration-none" href="{{ page_url('helloasso-import') }}">Importer depuis HelloAsso</a></li>
        <li class="list-group-item nav-sub-item border-top border-bottom-0"><a class="text-decoration-none" href="{{ page_url('admin-guide') }}">Aide</a></li>
    {% endif %}
    <li class="list-group-item nav-sub-item border-top border-bottom-0"><a class="text-decoration-none text-danger" href="{{ page_url('logout') }}">Me déconnecter</a></li>
{% endmacro %}

{% import _self as macro %}

<nav class="navbar navbar-expand-xl bg-primary shadow sticky-top mb-3">
    <div class="container">
        {# Desktop (>= 992px) : logo à gauche, menu déplié à droite #}
        <a class="navbar-brand d-none d-xl-flex flex-column align-items-center me-0" href="{{ page_url('home') }}">
            <span class="fs-4 text-uppercase text-white fw-bold mb-1">Le Comptoir des adhérents</span>
            <img src="/logo-blanc.png" alt="Ultramical86">
        </a>

        {# Desktop : menu de navigation + menu user #}
        <div class="collapse navbar-collapse d-none d-xl-block" id="mainNav">
            <ul class="navbar-nav ms-auto mb-2 mb-xl-0 align-items-xl-center">
                <li class="nav-item">
                    <a class="nav-link text-white fw-bold {{ macros.nav_active('home', cp) }} me-2" href="{{ page_url('home') }}" title="Accueil"><i class="bi bi-house-door-fill"></i></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-uppercase text-white fw-bold {{ macros.nav_active('trainings', cp) }}" href="{{ page_url('trainings') }}">Entraînements</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-uppercase text-white fw-bold {{ macros.nav_active('races', cp) }}" href="{{ page_url('races') }}">Courses</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-uppercase text-white fw-bold {{ macros.nav_active('trombinoscope', cp) }}" href="{{ page_url('trombinoscope') }}">Trombinoscope</a>
                </li>
                {% set moreActive = macros.nav_active('news', cp) == 'active' or macros.nav_active('events', cp) == 'active' or macros.nav_active('calendar', cp) == 'active' %}
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle text-uppercase text-white fw-bold {{ moreActive ? 'active' : '' }}" href="#" id="moreMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Actualités
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="moreMenu">
                        {% if newsCount > 0 %}
                        <li><a class="dropdown-item {{ macros.nav_active('news', cp) == 'active' ? 'fw-bold' : '' }}" href="{{ page_url('news') }}"><i class="bi bi-megaphone me-2"></i>Informations</a></li>
                        {% endif %}
                        {% if eventsCount > 0 %}
                        <li><a class="dropdown-item {{ macros.nav_active('events', cp) == 'active' ? 'fw-bold' : '' }}" href="{{ page_url('events') }}"><i class="bi bi-calendar3 me-2"></i>Rendez-vous UA86</a></li>
                        {% endif %}
                        <li><a class="dropdown-item {{ macros.nav_active('calendar', cp) == 'active' ? 'fw-bold' : '' }}" href="{{ page_url('calendar') }}"><i class="bi bi-calendar-week me-2"></i>Calendrier</a></li>
                    </ul>
                </li>
                <li class="nav-item dropdown ms-xl-3">
                    <a class="nav-link dropdown-toggle text-white" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle me-1"></i>{{ user.first_name }} {{ user.last_name[:1] }}. ({{ role_label(user.role) }})
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                        <li><a class="dropdown-item" href="{{ page_url('profile') }}"><i class="bi bi-person-vcard me-2"></i>Afficher mon profil</a></li>
                        <li><a class="dropdown-item" href="{{ page_url('change-password') }}"><i class="bi bi-key me-2"></i>Modifier mon mot de passe</a></li>
                        {% if can_manage_trainings() %}
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="{{ page_url('training-form') }}"><i class="bi bi-calendar-plus me-2"></i>Publier un entraînement</a></li>
                        {% endif %}
                        {% if can_view_detailed_members() %}
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="{{ page_url('season-members') }}"><i class="bi bi-person-video2 me-2"></i>Adhérents par saison</a></li>
                            <li><a class="dropdown-item" href="{{ page_url('inactive-members') }}"><i class="bi bi-person-lock me-2"></i>Adhérents désactivés</a></li>
                        {% endif %}
                        {% if is_admin() %}
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="{{ page_url('helloasso-campaigns') }}"><i class="bi bi-gear me-2"></i>Campagnes HelloAsso</a></li>
                            <li><a class="dropdown-item" href="{{ page_url('active-years') }}"><i class="bi bi-calendar-check me-2"></i>Saisons actives</a></li>
                            <li><a class="dropdown-item" href="{{ page_url('helloasso-import') }}"><i class="bi bi-cloud-download me-2"></i>Importer depuis HelloAsso</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="{{ page_url('admin-guide') }}"><i class="bi bi-question-circle me-2"></i>Aide</a></li>
                        {% endif %}
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="{{ page_url('logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Me déconnecter</a></li>
                    </ul>
                </li>
            </ul>
        </div>

        {# Mobile (< 992px) : logo + texte empilés à gauche, burger à droite #}
        <a class="navbar-brand d-xl-none d-flex flex-column align-items-center me-0" href="{{ page_url('home') }}">
            <span class="fs-4 text-uppercase text-white fw-bold">Le Comptoir des adhérents</span>
            <img src="/logo-blanc.png" alt="Ultramical86" class="mb-1">
        </a>
        <button class="navbar-toggler d-xl-none p-1" style="position:absolute;right:1rem;top:50%;transform:translateY(-50%);" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNav" aria-controls="mobileNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</nav>

{# Offcanvas mobile : volet latéral avec tout le menu #}
<div class="offcanvas offcanvas-end" tabindex="-1" id="mobileNav" aria-labelledby="mobileNavLabel">
    <div class="offcanvas-header border-0 pb-0">
        <h5 class="offcanvas-title" id="mobileNavLabel">Au menu du Comptoir</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
    </div>
    <div class="offcanvas-body">
        <ul class="list-group list-group-flush">
            <li class="list-group-item py-1"><a class="text-decoration-none {{ macros.nav_active('home', cp) == 'active' ? 'fw-bold' : '' }}" href="{{ page_url('home') }}"><i class="bi bi-house me-2"></i>Accueil</a></li>
            <li class="list-group-item py-1"><a class="text-decoration-none {{ macros.nav_active('trainings', cp) == 'active' ? 'fw-bold' : '' }}" href="{{ page_url('trainings') }}"><i class="bi bi-calendar2-week me-2"></i>Entraînements</a></li>
            <li class="list-group-item py-1"><a class="text-decoration-none {{ macros.nav_active('races', cp) == 'active' ? 'fw-bold' : '' }}" href="{{ page_url('races') }}"><i class="bi bi-rocket-takeoff me-2"></i>Courses</a></li>
            <li class="list-group-item py-1"><a class="text-decoration-none {{ macros.nav_active('trombinoscope', cp) == 'active' ? 'fw-bold' : '' }}" href="{{ page_url('trombinoscope') }}"><i class="bi bi-person-rolodex me-2"></i>Trombinoscope</a></li>
            {% if newsCount > 0 %}
            <li class="list-group-item py-1"><a class="text-decoration-none {{ macros.nav_active('news', cp) == 'active' ? 'fw-bold' : '' }}" href="{{ page_url('news') }}"><i class="bi bi-megaphone me-2"></i>Informations</a></li>
            {% endif %}
            {% if eventsCount > 0 %}
            <li class="list-group-item py-1"><a class="text-decoration-none {{ macros.nav_active('events', cp) == 'active' ? 'fw-bold' : '' }}" href="{{ page_url('events') }}"><i class="bi bi-calendar3 me-2"></i>Rendez-vous UA86</a></li>
            {% endif %}
            <li class="list-group-item py-1"><a class="text-decoration-none {{ macros.nav_active('calendar', cp) == 'active' ? 'fw-bold' : '' }}" href="{{ page_url('calendar') }}"><i class="bi bi-calendar-week me-2"></i>Calendrier</a></li>
            {{ macro.user_menu_items(user) }}
        </ul>
    </div>
</div>
