<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title ? title ~ ' - ' : '' }}{{ config.app_name ?? 'App' }}</title>
	<meta name="author" content="Loïc Gaonach" />
	<meta name="Reply-To" content="contact@ultramical86.net" />
	<meta name="Language" content="fr" />
	<meta name="Copyright" content="©2026 - Ultramical86 - Gaonach.com " />
    <link rel="icon" type="image/png" sizes="16x16" href="{{ base_url('/public/favicon-16x16.png') }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ base_url('/public/favicon-32x32.png') }}">
    <link rel="icon" type="image/x-icon" href="{{ base_url('/favicon.ico') }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ base_url('/public/apple-touch-icon.png') }}">
    <link rel="manifest" href="{{ base_url('/public/site.webmanifest') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="{{ asset_url('/public/css/theme.css') }}">
</head>
<body>
{% if user is not null %}
    {% include 'components/navbar.twig' %}
{% endif %}

<main class="container py-4">
    {% for flash in flashes %}
        <div class="alert alert-{{ flash.type }}" role="alert">{{ flash.message }}</div>
    {% endfor %}

    {% block content %}{% endblock %}
</main>

{# Les modales sont rendues hors de <main> : <main> a position:relative + z-index:1
   (voir plus bas), ce qui crée un contexte d'empilement qui piège toute modale
   Bootstrap en dessous de la navbar sticky, quel que soit son propre z-index. #}
{% block modals %}{% endblock %}

<footer class="container text-center text-muted small py-3">
    &copy; {{ "now"|date('Y') }} Le Comptoir des adhérents<span class="d-none d-md-inline"> - </span><br class="d-md-none">
    Ultramical86.net - Gaonach.com
</footer>

<button id="scrollTop" onclick="window.scrollTo({top:0,behavior:'smooth'})" class="rounded-circle" style="position:fixed;bottom:20px;right:50px;width:44px;height:44px;display:none;z-index:1000;background:rgba(255,255,255,0.8);border:1px solid var(--bs-primary);color:var(--bs-primary);cursor:pointer;" title="Retour en haut">
    <i class="bi bi-arrow-up" style="font-size:1.2rem;"></i>
</button>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
<script src="{{ asset_url('public/js/scroll-top.js') }}"></script>
</body>
</html>
