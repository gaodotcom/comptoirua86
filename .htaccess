Options -Indexes

# La racine web est la racine du projet : seuls index.php, public/ et
# quelques fichiers statiques doivent être servis directement. Tout le reste
# (.env, .git, database/, templates/, controllers/, vendor/...) passe par le
# routeur, qui répond 404.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteRule ^(index\.php|favicon\.ico|robots\.txt|logo-blanc\.png)$ - [L]
    RewriteRule ^(public|\.well-known)/ - [L]

    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Filet de sécurité si mod_rewrite est indisponible : bloque les fichiers et
# dossiers cachés (.env, .git...) et les fichiers de configuration/données.
RedirectMatch 404 "/\.(?!well-known/)"
<FilesMatch "\.(env|sql|md|lock|json|ya?ml|neon|xml|properties|twig|sh|ini|log)$">
    Require all denied
</FilesMatch>
